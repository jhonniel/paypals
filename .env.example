# =============================================================================
# Paypals — Environment Variables
# Copy to .env.local (local) or set in Vercel Project Settings (production).
# =============================================================================

# App (REQUIRED in production — must be your public HTTPS URL)
# Public site URL used for invite / auth redirects when request host is unavailable.
# Must match the URL users open in the browser (not localhost in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service role (REQUIRED in production for account deletion / admin storage purge)
# Never expose this to the browser. Vercel → Environment Variables → Production only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OCR (optional — demo fallback used when unset)
# provider: ocrspace | google | tesseract | openai
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=

# SMTP email (optional — access-request alerts + invite emails)
# Example Gmail: host smtp.gmail.com, port 587, use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=devjry@gmail.com
SMTP_PASS=wilv zedl bnoy clzm
SMTP_FROM="Paypals Do not reply"
# Where to notify when someone tries to log in without an invite (Ygay)
INVITE_ADMIN_EMAIL=ygay@their-email.com

# Cron — keep free-tier Supabase from pausing (Vercel Cron + optional manual curl)
# Generate: openssl rand -hex 32
CRON_SECRET=
# Optional: deployed app URL for GitHub Actions / local script (also pings /api/health)
KEEP_AWAKE_URL=